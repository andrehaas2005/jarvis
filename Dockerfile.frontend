# HUD (frontend) do JARVIS — site estático puro, sem build (sem package.json).
# Nginx só serve os arquivos; toda a lógica roda no navegador (script.js fala
# direto com o backend em https://jarvis-api.andre.haas.nom.br via fetch/CORS).
FROM nginx:alpine

# Sobrescreve o nginx.conf default — sem isso, a Cloudflare na frente do
# domínio aplicava até 4h de cache de navegador em html/js/css sem que a
# origem mandasse Cache-Control nenhum, e um deploy novo de script.js podia
# demorar até 4h pra chegar de fato no navegador do usuário (achado real em
# produção). Ver nginx.frontend.conf pro motivo completo.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

COPY index.html styles.css script.js gestures.js visualizer3d.js /usr/share/nginx/html/
COPY earthhologram.gif radar.gif /usr/share/nginx/html/

# Chat de texto (SCRUM-26/27/28) — o painel em si vive dentro de index.html
COPY chat.css chat.js /usr/share/nginx/html/

# Login do HUD (SCRUM-56)
COPY login.html login.css login.js /usr/share/nginx/html/

# Termos de Uso / Política de Privacidade (SCRUM-62) — exigidos pelo Google
# pra publicar a tela de consentimento OAuth (Testing -> Production).
COPY terms.html privacy.html legal.css /usr/share/nginx/html/
COPY assets/brand/ /usr/share/nginx/html/assets/brand/

EXPOSE 80
