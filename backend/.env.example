# Configuração do backend JARVIS (Python/FastAPI)
# Copie este arquivo para .env e preencha os valores reais.

# Ambiente
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO

# API
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000

# Gmail MCP Server (SCRUM-14)
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# Google Calendar MCP Server (SCRUM-15)
CALENDAR_CREDENTIALS_PATH=
CALENDAR_TOKEN_PATH=

# Retry / idempotência (SCRUM-45, SCRUM-46)
JARVIS_RETRY_MAX_ATTEMPTS=3
JARVIS_RETRY_BACKOFF_SECONDS=2

# ElevenLabs (SCRUM-48)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Contacts MCP Server (SCRUM-49) — Google Contacts / People API
# (sem custo, usa os contatos reais da mesma conta Google do Gmail/Calendar)
CONTACTS_CREDENTIALS_PATH=
CONTACTS_TOKEN_PATH=
